{
  "name": "@agegr/pi-web",
  "version": "0.10.0",
  "description": "Web UI for the pi coding agent",
  "homepage": "https://github.com/agegr/pi-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agegr/pi-web.git"
  },
  "bugs": {
    "url": "https://github.com/agegr/pi-web/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.2",
    "ios_saf 16.2"
  ],
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    "lib/browser-open.js",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 30141",
    "dev:lan": "node bin/network-exposure-warning.js 0.0.0.0 && next dev -H 0.0.0.0 -p 30141",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 30141",
    "start:lan": "node bin/network-exposure-warning.js 0.0.0.0 && next start -H 0.0.0.0 -p 30141",
    "desktop:dev": "node scripts/desktop-dev.mjs --config src-tauri/tauri.dev.conf.json",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:build": "npm run desktop:prepare && tauri build",
    "desktop:build:local": "node scripts/desktop-build-local.mjs",
    "web": "node scripts/web-dev.mjs",
    "release:manifest": "node scripts/write-component-versions.mjs",
    "release:verify": "node scripts/verify-release-components.mjs",
    "drift": "node scripts/measure-fork-drift.mjs",
    "preview-runtime": "node scripts/build-preview-runtime.mjs",
    "desktop:verify": "node scripts/verify-packaged-codemode.mjs",
    "test:release-tools": "node --test scripts/*.test.mjs",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint . && npm run check:branding",
    "check:branding": "node --test lib/branding.test.mjs",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public",
    "postinstall": "node bin/prepare-terminal.js",
    "test:terminal": "node e2e/terminal.mjs",
    "test:e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@earendil-works/pi-agent-core": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "^6.0.2",
    "croner": "^10.0.1",
    "js-yaml": "^5.4.2",
    "next": "16.3.8",
    "node-pty": "1.2.0-beta.15",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "semver": "7.8.5",
    "undici": "8.11.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/browser": "4.2.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@tauri-apps/cli": "^2.12.1",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/semver": "7.8.0",
    "@types/web-push": "^3.6.4",
    "ansi_up": "^6.0.6",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sucrase": "3.35.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  },
  "allowScripts": {
    "node-pty@1.2.0-beta.15": true
  }
}
